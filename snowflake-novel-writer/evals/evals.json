{
  "skill_name": "snowflake-novel-writer",
  "evals": [
    {
      "id": 1,
      "prompt": "我想从零开始写一个职场短篇，主角是一个被边缘化的实习生，但我不想写成鸡汤逆袭文。",
      "expected_output": "先进行创作取向校准，询问文风气质、避雷套路和读后余味，再进入雪花法的早期步骤。",
      "files": [],
      "assertions": [
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "第0步",
          "description": "应先进入创作取向校准"
        },
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "文风",
          "description": "应主动询问文风或气质"
        },
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "俗套",
          "description": "应主动询问或识别想避开的俗套"
        }
      ]
    },
    {
      "id": 2,
      "prompt": "帮我写一个悬疑故事。退休刑警查20年前悬案。我不想走普通三幕式。",
      "expected_output": "识别用户不想使用标准三幕式，提供替代结构方案，而不是强行套入固定模板。",
      "files": [],
      "assertions": [
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "结构方案",
          "description": "应进入结构方案选择"
        },
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "倒叙",
          "description": "应能提供倒叙等替代结构"
        },
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "为什么适合这个故事",
          "description": "应说明结构选择理由"
        }
      ]
    },
    {
      "id": 3,
      "prompt": "我已经有一个小说片段：雨夜里，女主在便利店把前男友认成了死人。你别让我填一堆人物资料表，直接帮我把它做成更高级的故事。",
      "expected_output": "应支持从片段反推，不强迫线性流程，不要求低价值人物档案，并补主题、关系张力和叙述声音。",
      "files": [],
      "assertions": [
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "片段",
          "description": "应基于现有片段推进"
        },
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "叙述",
          "description": "应补叙述声音或叙述设置"
        },
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "关系",
          "description": "应补关系张力或秘密"
        }
      ]
    },
    {
      "id": 4,
      "prompt": "直接给我写，不要一步一步问。题材是校园悬疑，风格冷一点，先给我一个开头。",
      "expected_output": "应使用极简前置判断后直接进入样章，而不是直接吐全文或卡在漫长问答里。",
      "files": [],
      "assertions": [
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "样章",
          "description": "应先给样章方案或样章"
        },
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "叙述距离",
          "description": "应体现叙述声音设置"
        },
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "冷",
          "description": "应响应用户指定的气质"
        }
      ]
    },
    {
      "id": 5,
      "prompt": "我想写一个仙侠复仇故事，但最怕写成模板文。你要主动帮我拆掉套路。",
      "expected_output": "应触发反俗套检查，明确常见写法、当前风险和偏离策略。",
      "files": [],
      "assertions": [
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "反俗套",
          "description": "应包含反俗套检查"
        },
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "当前风险",
          "description": "应指出当前方案风险"
        },
        {
          "type": "contains",
          "target": "output",
          "path": "",
          "expected": "偏离策略",
          "description": "应给出偏离模板文的具体方法"
        }
      ]
    }
  ]
}
